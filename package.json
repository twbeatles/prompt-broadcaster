{
  "name": "ai-prompt-broadcaster",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/build.mjs --clean",
    "typecheck": "tsc --noEmit",
    "build": "node ./scripts/build.mjs",
    "rebuild": "npm run clean && npm run build",
    "docs:check": "node ./scripts/check-docs.mjs",
    "qa:smoke": "node ./scripts/qa-smoke.mjs",
    "qa:unit": "node ./scripts/qa-unit.mjs",
    "qa:extension": "node ./scripts/qa-extension.mjs",
    "selector:audit": "node ./scripts/selector-audit.mjs",
    "package:win": "powershell -ExecutionPolicy Bypass -File .\\package.ps1",
    "package:unix": "bash ./package.sh"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
